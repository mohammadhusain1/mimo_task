# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_print?schema=public&pgbouncer=true"

# JWT Authentication
JWT_SECRET="super_secret_jwt_key_for_smart_print_system_2026_min_32_chars"
JWT_EXPIRES_IN="24h"

# Security & Rate Limiting
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Processing & Security
FILE_STORAGE_ALLOWLIST="example.com,storage.googleapis.com,s3.amazonaws.com,cdn.smartprint.local"
PAGE_COUNT_DEFAULT=1

# Initial Administrator Credentials (used during seed)
ADMIN_EMAIL="admin@smartprint.com"
ADMIN_PASSWORD="Admin@123"
